#!/usr/bin/env python3
"""memory-gui — tiny local web UI for bin/memory (on|off|status)."""
import json
import os
import subprocess
from http.server import BaseHTTPRequestHandler, HTTPServer

SCRIPT = os.path.dirname(os.path.abspath(__file__))
MEMORY = os.path.join(SCRIPT, "memory")

PAGE = """<!doctype html>
<html><head><meta charset="utf-8"><title>memory</title>
<style>
  body { background:#111; color:#eee; font-family:-apple-system,sans-serif;
         display:flex; flex-direction:column; align-items:center; margin-top:20vh; }
  h1 { font-size:1.2em; font-weight:normal; color:#888; }
  #state { font-size:3em; margin:0.3em 0; }
  .on { color:#4c9; } .off { color:#e55; }
  button { background:#333; color:#eee; border:1px solid #555; border-radius:6px;
           padding:10px 24px; font-size:1em; margin:8px; cursor:pointer; }
  button:hover { background:#444; }
</style></head>
<body>
<h1>markdown-memory</h1>
<div id="state" class="off">…</div>
<div>
  <button onclick="set('on')">Turn ON</button>
  <button onclick="set('off')">Turn OFF</button>
</div>
<script>
async function refresh() {
  const s = await (await fetch('/status')).json();
  show(s.on);
}
function show(on) {
  const el = document.getElementById('state');
  el.textContent = on ? 'ON' : 'OFF';
  el.className = on ? 'on' : 'off';
}
async function set(v) {
  const r = await (await fetch('/' + v, {method:'POST'})).json();
  if (r.ok) show(r.on); else alert(r.error);
}
refresh();
</script>
</body></html>"""


def memory(*args):
    return subprocess.run([MEMORY, *args], capture_output=True, text=True)


def status_json():
    out = memory("status")
    # bin/memory prints "memory: ON[, auto-inject: OFF]" — the engine state is
    # the first segment; "OFF" also appears later when auto-inject is off.
    return {"on": out.stdout.startswith("memory: ON")}


class Handler(BaseHTTPRequestHandler):
    def send(self, code, body, ctype="application/json"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/":
            self.send(200, PAGE.encode(), "text/html; charset=utf-8")
        elif self.path == "/status":
            self.send(200, json.dumps(status_json()).encode())
        else:
            self.send(404, b'{"error":"not found"}')

    def do_POST(self):
        if self.path not in ("/on", "/off"):
            self.send(404, b'{"error":"not found"}')
            return
        r = memory(self.path[1:])
        if r.returncode != 0:
            self.send(500, json.dumps({"ok": False, "error": r.stderr.strip() or r.stdout.strip()}).encode())
            return
        self.send(200, json.dumps({"ok": True, "on": "OFF" not in r.stdout}).encode())

    def log_message(self, *a):
        pass


try:
    server = HTTPServer(("127.0.0.1", 8765), Handler)
except OSError:
    server = HTTPServer(("127.0.0.1", 0), Handler)
print(f"memory GUI: http://127.0.0.1:{server.server_port}", flush=True)
server.serve_forever()
