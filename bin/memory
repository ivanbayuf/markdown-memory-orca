#!/bin/sh
# memory on|off|auto on|auto off|status — toggle markdown-memory for new sessions.
# .disabled turns the engine off; .auto-off keeps the memory tool but no injection.
set -u
ROOT="${MEMORY_ROOT:-$HOME/memory}"
OFF_MARK="$ROOT/.disabled"
AUTO_OFF_MARK="$ROOT/.auto-off"

mode() {
  if [ -f "$OFF_MARK" ]; then printf "memory: OFF"
  else
    printf "memory: ON"
    [ -f "$AUTO_OFF_MARK" ] && printf ", auto-inject: OFF" || printf ", auto-inject: ON"
  fi
  printf "\n"
}

case "${1:-status}" in
  on)   mkdir -p "$ROOT" && rm -f "$OFF_MARK" && mode ;;
  off)  mkdir -p "$ROOT" && touch "$OFF_MARK" && mode ;;
  auto) case "${2:-}" in
          on)  rm -f "$AUTO_OFF_MARK" && mode ;;
          off) mkdir -p "$ROOT" && touch "$AUTO_OFF_MARK" && mode ;;
          *)   echo "usage: memory auto on|off" >&2; exit 2 ;;
        esac ;;
  status) mode ;;
  *) echo "usage: memory on|off|auto on|auto off|status" >&2; exit 2 ;;
esac
