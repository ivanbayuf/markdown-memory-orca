{
  "manifestVersion": 2,
  "id": "memory-panel",
  "name": "Memory Panel",
  "version": "0.2.0",
  "description": "Toggle markdown-memory auto-run from the Orca sidebar.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
